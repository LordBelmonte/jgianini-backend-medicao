# ─────────────────────────────────────────
# AMBIENTE
# ─────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─────────────────────────────────────────
# BANCO DE DADOS
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# ─────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ─────────────────────────────────────────
# AUTENTICAÇÃO — DT-01: JWT Stateless
# JWT_SECRET: chave secreta para assinar tokens — use valor longo e aleatório em produção
# JWT_EXPIRES_IN: tempo de expiração do token (decisão: 8 horas)
# ─────────────────────────────────────────
JWT_SECRET="sua-chave-secreta-aqui"
JWT_EXPIRES_IN="8h"
